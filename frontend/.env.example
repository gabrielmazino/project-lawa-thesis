# Copy this file to ".env" (same folder) and fill in the values.
# Find them in Supabase: Project Settings -> API Keys, and the Project URL
# on the project's home page (or via the "Connect" button).
#
# The publishable key is designed to be used in the browser; security is
# enforced by Row Level Security in the database. NEVER put the
# "secret" / "service_role" key here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Address of the Flask backend (backend/app.py)
VITE_API_URL=http://localhost:5000
